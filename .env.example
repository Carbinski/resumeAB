# Jev. Required for matchups. The site loads without it; uploads fail when a résumé is judged.
TYPESAFE_API_KEY=

# Persistent directory for ladder.db, blobs/, and logs/. Back up the database and blobs together.
LADDER_DATA=data

# Set to 1 behind HTTPS so the session cookie is Secure. scripts/start.sh does this when it is unset.
LADDER_SECURE_COOKIES=

# Where Next.js proxies /api/ladder. The API listens on 127.0.0.1 only.
LADDER_API_ORIGIN=http://127.0.0.1:8000

# How many résumé placements may call the judge at once. Further uploads wait in order.
# The process keeps this between 1 and 32.
LADDER_MAX_PLACEMENTS=2
